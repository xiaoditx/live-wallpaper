#include <winver.h>
#include "resources.hpp"

#pragma code_page(65001) // UTF-8编译

// 图标资源
IDI_MY_ICON ICON "icon.ico"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     rcVersion
PRODUCTVERSION  rcVersion
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",        "小狄同学呀"
            VALUE "FileDescription",    "动态壁纸管理器"
            VALUE "FileVersion",        appVersion
            VALUE "InternalName",       "live_wallpaper.exe"
            VALUE "LegalCopyright",     "WTFPL 开源"
            VALUE "OriginalFilename",   "live_wallpaper.exe"
            VALUE "ProductName",        "Live Wallpaper"
            VALUE "ProductVersion",     appVersion
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END